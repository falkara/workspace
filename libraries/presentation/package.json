{
  "name": "@falkara/presentation",
  "version": "0.10.0",
  "description": "An Effect-based TypeScript library for interface design that derives each value from established standards, save one declared choice.",
  "keywords": [
    "accessibility",
    "color-contrast",
    "design-tokens",
    "effect",
    "fluid-typography",
    "oklch",
    "type-scale",
    "typography",
    "wcag"
  ],
  "homepage": "https://github.com/falkara/workspace/tree/main/libraries/presentation#readme",
  "bugs": {
    "url": "https://github.com/falkara/workspace/issues"
  },
  "license": "MIT",
  "author": "Filip Falcon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkara/workspace.git",
    "directory": "libraries/presentation"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#jsr.json": "./jsr.json",
    "#package.json": "./package.json",
    "#src/*": "./src/*.ts",
    "#vite.config": "./vite.config.ts"
  },
  "exports": {
    "./Color": {
      "types": "./dist/Color.d.mts",
      "default": "./dist/Color.mjs"
    },
    "./Colorimetry": {
      "types": "./dist/Colorimetry.d.mts",
      "default": "./dist/Colorimetry.mjs"
    },
    "./Fluid": {
      "types": "./dist/Fluid.d.mts",
      "default": "./dist/Fluid.mjs"
    },
    "./Layout": {
      "types": "./dist/Layout.d.mts",
      "default": "./dist/Layout.mjs"
    },
    "./Length": {
      "types": "./dist/Length.d.mts",
      "default": "./dist/Length.mjs"
    },
    "./Space": {
      "types": "./dist/Space.d.mts",
      "default": "./dist/Space.mjs"
    },
    "./Typography": {
      "types": "./dist/Typography.d.mts",
      "default": "./dist/Typography.mjs"
    },
    "./Viewport": {
      "types": "./dist/Viewport.d.mts",
      "default": "./dist/Viewport.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "vp pack"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "effect": "4.1.3"
  },
  "peerDependencies": {
    "effect": "^4.1.3"
  }
}
