{
  "name": "@falkara/simulation",
  "version": "0.0.0",
  "description": "An Effect-based TypeScript library for simulating state-based systems from streams to machines driven by input, each typed and run as the theory of coalgebras defines it.",
  "keywords": [
    "automata",
    "coalgebra",
    "effect",
    "mealy-machine",
    "moore-machine",
    "simulation",
    "state-machine"
  ],
  "homepage": "https://github.com/falkara/workspace/tree/main/libraries/simulation#readme",
  "bugs": {
    "url": "https://github.com/falkara/workspace/issues"
  },
  "license": "MIT",
  "author": "Filip Falcon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkara/workspace.git",
    "directory": "libraries/simulation"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#jsr.json": "./jsr.json",
    "#package.json": "./package.json",
    "#src/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/Entrypoint.d.mts",
      "default": "./dist/Entrypoint.mjs"
    },
    "./Coalgebra": {
      "types": "./dist/Coalgebra.d.mts",
      "default": "./dist/Coalgebra.mjs"
    },
    "./Coalgebra/DeterministicAutomaton": {
      "types": "./dist/Coalgebra/DeterministicAutomaton.d.mts",
      "default": "./dist/Coalgebra/DeterministicAutomaton.mjs"
    },
    "./Coalgebra/MealyMachine": {
      "types": "./dist/Coalgebra/MealyMachine.d.mts",
      "default": "./dist/Coalgebra/MealyMachine.mjs"
    },
    "./Coalgebra/ResumptionCoalgebra": {
      "types": "./dist/Coalgebra/ResumptionCoalgebra.d.mts",
      "default": "./dist/Coalgebra/ResumptionCoalgebra.mjs"
    },
    "./Coalgebra/SequenceCoalgebra": {
      "types": "./dist/Coalgebra/SequenceCoalgebra.d.mts",
      "default": "./dist/Coalgebra/SequenceCoalgebra.mjs"
    },
    "./Coalgebra/StreamCoalgebra": {
      "types": "./dist/Coalgebra/StreamCoalgebra.d.mts",
      "default": "./dist/Coalgebra/StreamCoalgebra.mjs"
    },
    "./Functor": {
      "types": "./dist/Functor.d.mts",
      "default": "./dist/Functor.mjs"
    },
    "./Functor/BinaryCoproductFunctor": {
      "types": "./dist/Functor/BinaryCoproductFunctor.d.mts",
      "default": "./dist/Functor/BinaryCoproductFunctor.mjs"
    },
    "./Functor/BinaryProductFunctor": {
      "types": "./dist/Functor/BinaryProductFunctor.d.mts",
      "default": "./dist/Functor/BinaryProductFunctor.mjs"
    },
    "./Functor/EffectFunctor": {
      "types": "./dist/Functor/EffectFunctor.d.mts",
      "default": "./dist/Functor/EffectFunctor.mjs"
    },
    "./Functor/ExponentFunctor": {
      "types": "./dist/Functor/ExponentFunctor.d.mts",
      "default": "./dist/Functor/ExponentFunctor.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "vp pack"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.5",
    "@effect/vitest": "4.1.5",
    "effect": "4.1.5"
  },
  "peerDependencies": {
    "effect": "^4.1.5"
  }
}
