  },
  "license": "MIT",
  "author": "Filip Falcon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkara/workspace.git",
    "directory": "libraries/simulation"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
