{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "description": "A platform that lets virtually anyone build digital experiences without the slop, with an extra focus on correctness and developer experience.",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Falkara s. r. o.",
    "url": "https://falkara.com"
  },
  "workspaces": [
    "applications/*",
    "libraries/*"
  ],
  "type": "module",
  "scripts": {
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --fix",
    "lint:check": "vp lint"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "vite-plus": "0.2.5"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "error"
    },
    "runtime": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "error"
    }
  }
}
