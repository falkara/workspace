{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "description": "A platform that lets virtually anyone build digital experiences without the slop, with an extra focus on correctness and developer experience.",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Falkara s. r. o.",
    "url": "https://falkara.com"
  },
  "workspaces": [
    "applications/*",
    "libraries/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@effect/platform-node": "4.0.1",
    "@effect/tsgo": "0.49.0",
    "@effect/vitest": "4.0.1",
    "ajv": "8.20.0",
    "effect": "4.0.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "download"
    }
  }
}
